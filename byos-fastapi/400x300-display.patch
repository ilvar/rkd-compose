 from fastapi import APIRouter, HTTPException, Request
-from fastapi.responses import FileResponse, Response
+from fastapi.responses import Response
+from PIL import Image
 
 from .. import config, models, utils
 from ..services import state
@@ -40,6 +42,25 @@ def _binary_response(image_blob: BytesIO, media_type: str) -> Response:
     return Response(content=payload, media_type=media_type, headers=headers)
 
 
+def _device_image_response(image_blob: BytesIO, media_type: str) -> Response:
+    """Resize device-facing images for non-standard TRMNL display panels."""
+    width = int(os.getenv('DISPLAY_WIDTH', '800'))
+    height = int(os.getenv('DISPLAY_HEIGHT', '480'))
+    if (width, height) == (800, 480):
+        return _binary_response(image_blob, media_type)
+
+    image_blob.seek(0)
+    with Image.open(image_blob) as source:
+        resized = source.resize((width, height), resample=Image.Resampling.LANCZOS)
+        output = BytesIO()
+        if media_type == 'image/bmp':
+            resized.convert('1').save(output, format='BMP')
+        else:
+            resized.save(output, format='PNG', optimize=True)
+    output.seek(0)
+    return _binary_response(output, media_type)
+
